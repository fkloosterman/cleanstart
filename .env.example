# Public, build-time variables. Safe to keep in a local .env (gitignored)
# since Vite inlines VITE_* vars into the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only secrets. NEVER prefix with VITE_, never commit real values.
# In production these are set as Vercel encrypted env vars; for testing in
# Lovable Cloud they're set under Cloud -> Secrets in the Lovable project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Optional — override the OpenRouter base URL (default: https://openrouter.ai/api/v1, local OpenAI compatible example: http://127.0.0.1:1234/v1)
OPENROUTER_URL=
# Optional — override the model for all purposes (default: openai/gpt-oss-120b:free, local example: openai/gpt-oss-20b)
OPENROUTER_MODEL=

# Per-purpose model map (D12). Each overrides OPENROUTER_MODEL for one kind
# of call; unset means fall back to OPENROUTER_MODEL, then the default.
# Development uses free models; production points extraction/composition at
# the bake-off winner (see docs/implementation-plan-personalization.md).
OPENROUTER_MODEL_CHAT=
OPENROUTER_MODEL_EXTRACTION=
OPENROUTER_MODEL_COMPOSITION=
# Comma-separated purposes whose calls must be routed only to zero-data-
# retention / no-training endpoints. Set to "extraction,composition" in the
# Vercel Production environment (D12); leave empty in dev (free models don't
# offer ZDR endpoints).
OPENROUTER_ZDR_PURPOSES=
